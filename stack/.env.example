# cp .env.example .env
TZ=America/New_York
PUID=1000            # `id -u`
PGID=1000            # `id -g`
APPDATA=/srv/appdata
MEDIA=/srv/media

# https://plex.tv/claim. Expires in 4 min; paste, then `docker compose up -d` right away. Clear after first boot.
PLEX_CLAIM=

# Off-box backup target (README Phase 9):
#   external USB drive:  BACKUP_REMOTE=/mnt/backup/omnicron/
#   another machine:     BACKUP_REMOTE=brad@192.168.1.10:OmnicronBackups/
BACKUP_REMOTE=
BACKUP_MEDIA=0       # 1 = also mirror /srv/media (USB drive target only)
